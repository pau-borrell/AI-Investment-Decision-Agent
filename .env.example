# No API keys needed: local Ollama or local HF/LoRA.
# Variables are read from the process environment; this file is an example.
SLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=mistral
HF_BASE_MODEL_PATH=
HF_LORA_ADAPTER_PATH=models/mistral7b-lora
HF_MAX_NEW_TOKENS=256
